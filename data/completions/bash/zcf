# bash completion for zcf(1)

_zcf_completions() {
    local cur prev words cword
    _init_completion || return

    local commands="dashboard console web gui run inspect env plan test diag research db service integrate"
    local db_actions="list show query submit verify delete export import"

    if [[ $cword -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        return 0
    fi

    case "${words[1]}" in
        console|web)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--host --port --allow-remote --no-browser" -- "$cur") )
            fi
            ;;
        run)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--sandbox --no-sandbox --allow-unconfined --dry-run --allow-network --timeout --headless --install-deps" -- "$cur") )
            else
                _filedir
            fi
            ;;
        inspect|plan)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--json" -- "$cur") )
            else
                _filedir
            fi
            ;;
        test)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--dry-run --record --contributor --timeout" -- "$cur") )
            else
                _filedir
            fi
            ;;
        diag)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--target --json" -- "$cur") )
            else
                _filedir
            fi
            ;;
        research)
            _filedir
            ;;
        db)
            if [[ $cword -eq 2 ]]; then
                COMPREPLY=( $(compgen -W "$db_actions" -- "$cur") )
            elif [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "--id --output --file" -- "$cur") )
            else
                _filedir
            fi
            ;;
        *)
            ;;
    esac
}

complete -F _zcf_completions zcf zcf-runner
