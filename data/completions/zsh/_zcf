#compdef zcf zcf-runner

_zcf() {
    local -a commands
    commands=(
        'dashboard:Display the interactive system dashboard'
        'console:Launch local browser-based Web Console'
        'web:Launch local browser-based Web Console'
        'gui:Launch graphical Control Center'
        'run:Execute an application through optimal runtime with sandboxing and gaming tuning'
        'runners:Discover, download, and manage Proton and Wine compatibility runners'
        'snapshot:Time-Machine instant restore points and prefix rollbacks'
        'vault:Universal Game Save Vault for discovery, backup, and prefix migration'
        'taskmgr:Monitor active processes, kill wineserver, and launch Wine diagnostic tools'
        'prescribe:Autonomous healing engine to analyze crashes and auto-repair prefixes'
        'components:Manage Windows runtime components and DLL overrides'
        'completions:Output shell completion script for Bash, Zsh, or Fish'
        'integrate:Manage Linux desktop application menu shortcuts'
        'inspect:Inspect an application binary or script'
        'env:Inspect host environment and runtimes'
        'doctor:Run pre-flight system readiness audit and gaming optimization check'
        'plan:Generate deterministic compatibility plan'
        'test:Test application compatibility execution'
        'diag:Analyze runtime failure log and synthesize fixes'
        'research:Execute 11-step empirical reverse engineering workflow'
        'db:Query or manage compatibility database'
        'history:View and compare execution test history'
        'service:Manage ZCF binfmt and system integration'
    )

    _arguments -C \
        '--version[Show version information]' \
        '(-h --help)'{-h,--help}'[Show help message]' \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            _describe -t commands 'zcf command' commands
            ;;
        args)
            case $words[1] in
                console|web)
                    _arguments \
                        '--host=[Host interface to bind]:host:' \
                        '--port=[Port to listen on]:port:' \
                        '--allow-remote[Permit binding to remote network interfaces]' \
                        '--no-browser[Do not automatically launch web browser]'
                    ;;
                run)
                    _arguments \
                        '--no-sandbox[Disable sandboxing]' \
                        '--allow-unconfined[Permit unconfined execution if sandbox unavailable]' \
                        '--dry-run[Perform dry run only]' \
                        '--allow-network[Permit network access in sandbox]' \
                        '--timeout=[Execution timeout in seconds]:timeout:' \
                        '--headless[Force execution under virtual Xvfb display]' \
                        '--install-deps[Automatically install missing package dependencies]' \
                        '--gamemode[Wrap execution with Feral GameMode]' \
                        '--gamescope[Execute inside Gamescope nested compositor]' \
                        '--upscale=[Upscaling filter]:filter:(fsr nis pixel linear)' \
                        '--fsr-sharpness=[FSR upscaler sharpness (0-10)]:sharpness:' \
                        '--fps-limit=[Frame rate cap / refresh rate]:fps:' \
                        '--mangohud[Enable MangoHud performance overlay]' \
                        '--tuning-preset=[Use preconfigured performance profile]:preset:(esports 4k_fidelity power_saver minimal_overlay)' \
                        '*:application binary:_files'
                    ;;
                runners)
                    _arguments \
                        '1:(list available install)' \
                        '--limit=[Max releases to query]:limit:' \
                        '--json[Output machine-readable JSON]' \
                        '*:archive or release tag:_files'
                    ;;
                snapshot)
                    _arguments \
                        '1:(create list restore delete)' \
                        '--label=[Snapshot description label]:label:' \
                        '--json[Output machine-readable JSON]' \
                        '*:prefix path:_files -/'
                    ;;
                vault)
                    _arguments \
                        '1:(discover backup list restore delete)' \
                        '--app=[Application name filter]:app:' \
                        '--notes=[Backup notes]:notes:' \
                        '--json[Output machine-readable JSON]' \
                        '*:prefix path:_files -/'
                    ;;
                taskmgr)
                    _arguments \
                        '1:(list kill reset-locks launch)' \
                        '--prefix=[Prefix filter]:prefix:_files -/' \
                        '--json[Output machine-readable JSON]' \
                        '*:prefix path:_files -/'
                    ;;
                prescribe)
                    _arguments \
                        '1:(generate apply)' \
                        '--app=[Application name]:app:' \
                        '--prefix=[Target prefix path]:prefix:_files -/' \
                        '--dry-run[Simulate repair without modifying prefix]' \
                        '--json[Output machine-readable JSON]' \
                        '*:log file:_files'
                    ;;
                components)
                    _arguments \
                        '1:(list install overrides)' \
                        '--prefix=[Prefix path filter]:prefix:_files -/' \
                        '--timeout=[Installation timeout in seconds]:timeout:' \
                        '--set[Set DLL override]:*:' \
                        '--remove=[Remove DLL override]:dll:' \
                        '--json[Output machine-readable JSON]' \
                        '*:prefix path:_files -/'
                    ;;
                completions)
                    _arguments \
                        '1:(bash zsh fish)'
                    ;;
                inspect|plan|doctor|env)
                    _arguments \
                        '--json[Output JSON]' \
                        '*:target file:_files'
                    ;;
                test)
                    _arguments \
                        '--dry-run[Perform dry run only]' \
                        '--execute[Perform real live execution test]' \
                        '--record[Record outcome into compatibility knowledge base]' \
                        '--contributor=[Contributor attribution name]:name:' \
                        '*:target file:_files'
                    ;;
                diag)
                    _arguments \
                        '--target=[Optional target executable]:target file:_files' \
                        '--json[Output JSON]' \
                        '*:log file:_files'
                    ;;
                research)
                    _arguments \
                        '1:target binary:_files' \
                        '2:log file:_files'
                    ;;
                db)
                    _arguments \
                        '1:(list show query submit verify delete export import)' \
                        '--id=[Entry ID]' \
                        '--app=[Application binary]:app:_files' \
                        '--runtime=[Runtime identifier]:runtime:' \
                        '--arch=[Architecture]:arch:' \
                        '--status=[Status]:status:' \
                        '--output=[Output file]:output file:_files' \
                        '--file=[Input file]:input file:_files'
                    ;;
                history)
                    _arguments \
                        '--sha256=[Filter runs by SHA-256]:hash:' \
                        '--limit=[Max runs to display]:limit:' \
                        '--compare[Compare two run IDs]:*:' \
                        '--clear[Clear all stored execution run logs]' \
                        '--json[Output JSON]'
                    ;;
                service)
                    _arguments \
                        '1:(register-binfmt unregister-binfmt cleanup-prefixes list-prefixes)' \
                        '--max-age-days=[Max prefix age in days]:days:'
                    ;;
                integrate)
                    _arguments \
                        '--name=[Custom display name]:name:' \
                        '--list[List all currently integrated applications]' \
                        '--remove[Remove integrated desktop launcher]' \
                        '*:application binary:_files'
                    ;;
            esac
            ;;
    esac
}

_zcf "$@"
