{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZCF Application Metadata Schema",
  "description": "Standard structured representation of an inspected application artifact",
  "type": "object",
  "required": ["artifact_path", "sha256", "byte_size", "format", "architecture", "subsystem"],
  "properties": {
    "artifact_path": { "type": "string" },
    "file_name": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "byte_size": { "type": "integer", "minimum": 0 },
    "format": { "type": "string", "enum": ["pe", "elf", "macho", "script", "archive", "unknown"] },
    "architecture": { "type": "string", "enum": ["x86_64", "i386", "arm64", "arm", "riscv64", "universal", "all", "unknown"] },
    "subsystem": { "type": "string", "enum": ["console", "gui", "native", "posix", "unknown"] },
    "is_managed": { "type": "boolean" },
    "runtime_family": { "type": "string" },
    "declared_dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "entry_point": { "type": ["string", "null"] },
    "security_indicators": {
      "type": "object",
      "properties": {
        "has_anti_cheat": { "type": "boolean" },
        "has_drm": { "type": "boolean" },
        "requires_kernel_driver": { "type": "boolean" }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
