{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZCF Compatibility Plan Schema",
  "description": "Structured execution plan and recommendation generated by the Compatibility Planner",
  "type": "object",
  "required": ["plan_id", "artifact_sha256", "selected_runtime_id", "confidence_score", "reasoning"],
  "properties": {
    "plan_id": { "type": "string" },
    "artifact_sha256": { "type": "string" },
    "selected_runtime_id": { "type": ["string", "null"] },
    "selected_runtime_name": { "type": ["string", "null"] },
    "confidence_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "execution_mode": { "type": "string", "enum": ["native", "translation", "emulation", "sandboxed", "blocked"] },
    "reasoning": { "type": "string" },
    "satisfied_requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missing_requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "candidate_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runtime_id", "eligible", "score", "notes"],
        "properties": {
          "runtime_id": { "type": "string" },
          "eligible": { "type": "boolean" },
          "score": { "type": "number" },
          "notes": { "type": "string" }
        }
      }
    },
    "recommended_configuration": {
      "type": "object",
      "properties": {
        "environment_variables": { "type": "object" },
        "launch_prefix": { "type": ["string", "null"] },
        "wrapper_arguments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "safe_next_steps": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
